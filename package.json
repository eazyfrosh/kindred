{
  "name": "kindred",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "test:rules": "firebase emulators:exec --project demo-kindred --only firestore,storage \"npm run test:rules:only\"",
    "test:ledger": "node --conditions=react-server --import tsx --test tests/ledger.integration.ts",
    "test:emulators": "firebase emulators:exec --project demo-kindred --only firestore,storage \"npm run test:rules:only && npm run test:ledger\"",
    "test:rules:only": "tsx --test tests/rules.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node tests/http-smoke.mjs"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "15.29.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
